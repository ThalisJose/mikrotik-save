# --- NetBox (produção) ---
NETBOX_URL=https://netbox.exemplo.com
NETBOX_TOKEN=troque-por-um-token-real
NETBOX_VALIDATE_CERTS=true
NETBOX_CACHE_MAX_AGE_DAYS=7

# --- Execução ---
INVENTORY_MODE=netbox        # netbox | local
TARGET=all                   # all | <hostname-do-inventario>
BACKUP_BATCH_SIZE=10
BACKUP_BATCH_PAUSE_SECONDS=5

# --- Git (repositório de DADOS/backups, separado do repositório de código) ---
GIT_USER_NAME=mikrotik-backup-bot
GIT_USER_EMAIL=mikrotik-backup-bot@exemplo.com
GIT_REMOTE_NAME=origin
GIT_DEFAULT_BRANCH=main
# Caminho, no HOST, do clone local do repositório de backups (docker-compose monta em /app/data)
BACKUPS_REPO_HOST_DIR=../mikrotik-data
# Caminho, DENTRO do container, do repositório de backups (normalmente não precisa mudar)
BACKUPS_REPO_DIR=/app/data

# --- Retenção ---
# Snapshots datados (backups/<host>/<timestamp>.rsc) com mais dias que isso são
# removidos da árvore de trabalho (continuam recuperáveis via histórico do git).
# latest.rsc nunca é podado.
RETENTION_DAYS=90

# --- Notificação por e-mail (SMTP via curl) ---
# Exemplo Gmail: smtps://smtp.gmail.com:465 (com NOTIFY_SMTP_SSL_REQD=true)
# Exemplo com STARTTLS: smtp://smtp.exemplo.com:587 (com NOTIFY_SMTP_SSL_REQD=true)
NOTIFY_SMTP_URL=
NOTIFY_SMTP_FROM=mikrotik-backup-bot@exemplo.com
NOTIFY_SMTP_TO=voce@exemplo.com,outro@exemplo.com
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_SSL_REQD=true

# --- Teste local (sem NetBox), usado por inventory/local/hosts.yml ---
MIKROTIK_TEST_HOST=10.10.10.1
MIKROTIK_TEST_USER=admin
MIKROTIK_TEST_PASSWORD=
MIKROTIK_TEST_PORT=22
